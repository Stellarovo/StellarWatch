<Window x:Class="StellarWatch.Windows.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StellarWatch.Windows"
        xmlns:controls="clr-namespace:StellarWatch.Controls"
        mc:Ignorable="d"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True"
        x:Name="Win"
        Title="">

    <Window.Resources>
        <SolidColorBrush x:Key="ModuleBrush" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="Back" Color="#50181818"/>
    </Window.Resources>

    <Grid x:Name="Content" Width="2560" Height="1440"
          Margin="-118,0,0,0">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1"/>
        </Grid.LayoutTransform>

        <Grid.Effect>
            <local:PincushionEffect 
                Width="{Binding Width, ElementName=Win, Converter={StaticResource Math}, ConverterParameter=x*4}"
                Height="{Binding Height, ElementName=Win, Converter={StaticResource Math}, ConverterParameter=x*4}" 
                Power="-0.31"/>
        </Grid.Effect>

        <!--PLACEHOLDER-->
        <Line X1="0" X2="2560"
              Y1="0" Y2="1440" Stroke="#00000000"/>

        <Grid x:Name="ModulesGrid"
              VerticalAlignment="Top"
              HorizontalAlignment="Left"
              Margin="0,44,0,0">

            <Grid.RenderTransform>
                <ScaleTransform ScaleX="1.22"/>
            </Grid.RenderTransform>

            <!-- 一体背景：左侧尖头 + 右侧自适应渐变条（无重叠） -->
            <Grid Height="42" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42"/>   <!-- 左侧尖头固定宽度 -->
                    <ColumnDefinition Width="Auto"/> <!-- 右侧完全自适应内容 -->
                </Grid.ColumnDefinitions>

                <!-- 左侧尖头 -->
                <Path Grid.Column="0"
                      Data="M 0,0 L 42,0 L 42,42 Z"
                      Fill="{StaticResource Back}"
                      Stretch="Fill"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"/>

                <!-- 斜线装饰 -->
                <Line Grid.Column="0"
                      X1="0" Y1="0" X2="42" Y2="42"
                      StrokeThickness="2"
                      Stroke="#bbffffff"
                      IsHitTestVisible="False"/>

                <!-- 右侧渐变条（干净衔接，无负边距） -->
                <Border Grid.Column="1"
                        Height="42"
                        Margin="0,0,0,0"
                        VerticalAlignment="Stretch">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#50181818" Offset="0"/>
                            <GradientStop Color="#50181818" Offset="0.75"/>
                            <GradientStop Color="#00000000" Offset="0.95"/>
                            <GradientStop Color="#00000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>

                    <!-- 内容区域 -->
                    <StackPanel x:Name="DisplayLine"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Margin="-5,0,8,0">

                        <StackPanel x:Name="Modules"
                                    Orientation="Horizontal"
                                    Height="42">
                            <StackPanel.Resources>
                                <Style TargetType="controls:EnabledModuleTimer">
                                    <Setter Property="Margin" Value="1,2,1,2"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="{StaticResource ModuleBrush}"/>
                                    <Setter Property="MinOpacity" Value="1.0"/>
                                    <Setter Property="Scale" Value="0.70"/>
                                </Style>
                            </StackPanel.Resources>
                        </StackPanel>

                        <StackPanel Name="Counters"
                                    Orientation="Horizontal"
                                    Height="42"
                                    VerticalAlignment="Center">

                            <Label Name="Timer"
                                   Content="00:00:00"
                                   MinWidth="110"
                                   Visibility="Collapsed"
                                   FontSize="30"
                                   FontFamily="{StaticResource SmallTitleFont}"
                                   FontWeight="ExtraBold"
                                   HorizontalContentAlignment="Left"
                                   VerticalContentAlignment="Center"
                                   Foreground="{StaticResource ModuleBrush}">
                                <Label.LayoutTransform>
                                    <ScaleTransform ScaleX="0.96"/>
                                </Label.LayoutTransform>
                            </Label>

                            <Grid x:Name="Raid"
                                  Visibility="Collapsed"
                                  Margin="6,0,0,0"
                                  VerticalAlignment="Center">

                                <Ellipse Width="7" Height="7"
                                         Fill="#ee67c06b"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Center"/>

                                <Label x:Name="RaidLabel"
                                       Foreground="{StaticResource ModuleBrush}"
                                       Content="0"
                                       FontFamily="{StaticResource SmallTitleFont}"
                                       FontSize="24"
                                       VerticalContentAlignment="Center"
                                       HorizontalContentAlignment="Left"
                                       Margin="7,2,-4,0"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right">
                                    <Label.LayoutTransform>
                                        <ScaleTransform ScaleX="0.96"/>
                                    </Label.LayoutTransform>
                                </Label>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>